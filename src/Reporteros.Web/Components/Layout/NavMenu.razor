@inject Reporteros.Web.Services.TokenStorage Tokens
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">REPORTEROS</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="competiciones">
                <span class="bi bi-trophy-nav-menu" aria-hidden="true"></span> Competiciones
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="partidos">
                <span class="bi bi-calendar-event-nav-menu" aria-hidden="true"></span> Partidos
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="clasificacion">
                <span class="bi bi-bar-chart-nav-menu" aria-hidden="true"></span> Clasificación
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="noticias">
                <span class="bi bi-newspaper-nav-menu" aria-hidden="true"></span> Noticias
            </NavLink>
        </div>
        @if (Tokens.EstaAutenticado)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/competiciones/crear">
                    <span class="bi bi-plus-circle-nav-menu" aria-hidden="true"></span> Crear competición
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/partidos/crear">
                    <span class="bi bi-plus-circle-nav-menu" aria-hidden="true"></span> Crear partido
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/partidos/resultado">
                    <span class="bi bi-pencil-square-nav-menu" aria-hidden="true"></span> Publicar resultado
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/articulos/crear">
                    <span class="bi bi-plus-circle-nav-menu" aria-hidden="true"></span> Crear artículo
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/articulos/publicar">
                    <span class="bi bi-pencil-square-nav-menu" aria-hidden="true"></span> Publicar artículo
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <span class="nav-link">Hola, @Tokens.Nombre (@Tokens.Rol)</span>
            </div>
            <div class="nav-item px-3">
                <button class="btn btn-link nav-link" @onclick="Logout">Cerrar sesión</button>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-box-arrow-in-right-nav-menu" aria-hidden="true"></span> Login
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        Tokens.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Tokens.OnChange -= StateHasChanged;
    }

    private void Logout()
    {
        Tokens.Limpiar();
        Nav.NavigateTo("/");
    }
}
